    required String salt,
    required String pinHash,
    this.isActive = const Value.absent(),
    this.createdAt = const Value.absent(),
    this.updatedAt = const Value.absent(),
  }) : name = Value(name),
       salt = Value(salt),
       pinHash = Value(pinHash);
