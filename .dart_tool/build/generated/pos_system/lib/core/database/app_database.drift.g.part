class Invoice extends DataClass implements Insertable<Invoice> {
  final int id;
  final String invoiceNumber;
  final int? customerId;
  final int? linkedSaleId;
  final String docType;
  final String? billToName;
  final String? billToAddress;
  final String? billToPhone;
  final String status;
  final String template;
  final String invoiceLanguage;
  final String currencyCode;
  final double exchangeRateToPkr;
  final DateTime? sentAt;
  final DateTime issueDate;
  final DateTime? dueDate;
  final DateTime? expiryDate;
  final double subtotal;
  final double discountAmount;
  final double taxAmount;
  final double total;
  final String? notes;
  final String? terms;
  final DateTime createdAt;
  const Invoice({
    required this.id,
    required this.invoiceNumber,
    this.customerId,
    this.linkedSaleId,
    required this.docType,
    this.billToName,
    this.billToAddress,
    this.billToPhone,
    required this.status,
    required this.template,
    required this.invoiceLanguage,
    required this.currencyCode,
    required this.exchangeRateToPkr,
    this.sentAt,
    required this.issueDate,
    this.dueDate,
    this.expiryDate,
    required this.subtotal,
    required this.discountAmount,
    required this.taxAmount,
    required this.total,
    this.notes,
    this.terms,
    required this.createdAt,
  });
  @override
  Map<String, Expression> toColumns(bool nullToAbsent) {
    final map = <String, Expression>{};
    map['id'] = Variable<int>(id);
    map['invoice_number'] = Variable<String>(invoiceNumber);
    if (!nullToAbsent || customerId != null) {
      map['customer_id'] = Variable<int>(customerId);
    }
    if (!nullToAbsent || linkedSaleId != null) {
      map['linked_sale_id'] = Variable<int>(linkedSaleId);
    }
    map['doc_type'] = Variable<String>(docType);
    if (!nullToAbsent || billToName != null) {
      map['bill_to_name'] = Variable<String>(billToName);
    }
    if (!nullToAbsent || billToAddress != null) {
      map['bill_to_address'] = Variable<String>(billToAddress);
    }
    if (!nullToAbsent || billToPhone != null) {
      map['bill_to_phone'] = Variable<String>(billToPhone);
    }
    map['status'] = Variable<String>(status);
    map['template'] = Variable<String>(template);
    map['invoice_language'] = Variable<String>(invoiceLanguage);
    map['currency_code'] = Variable<String>(currencyCode);
    map['exchange_rate_to_pkr'] = Variable<double>(exchangeRateToPkr);
    if (!nullToAbsent || sentAt != null) {
      map['sent_at'] = Variable<DateTime>(sentAt);
    }
    map['issue_date'] = Variable<DateTime>(issueDate);
    if (!nullToAbsent || dueDate != null) {
      map['due_date'] = Variable<DateTime>(dueDate);
    }
    if (!nullToAbsent || expiryDate != null) {
      map['expiry_date'] = Variable<DateTime>(expiryDate);
    }
    map['subtotal'] = Variable<double>(subtotal);
    map['discount_amount'] = Variable<double>(discountAmount);
    map['tax_amount'] = Variable<double>(taxAmount);
    map['total'] = Variable<double>(total);
    if (!nullToAbsent || notes != null) {
      map['notes'] = Variable<String>(notes);
    }
    if (!nullToAbsent || terms != null) {
      map['terms'] = Variable<String>(terms);
    }
    map['created_at'] = Variable<DateTime>(createdAt);
    return map;
  }

  InvoicesCompanion toCompanion(bool nullToAbsent) {
    return InvoicesCompanion(
      id: Value(id),
      invoiceNumber: Value(invoiceNumber),
      customerId: customerId == null && nullToAbsent
          ? const Value.absent()
          : Value(customerId),
      linkedSaleId: linkedSaleId == null && nullToAbsent
          ? const Value.absent()
          : Value(linkedSaleId),
      docType: Value(docType),
      billToName: billToName == null && nullToAbsent
          ? const Value.absent()
          : Value(billToName),
      billToAddress: billToAddress == null && nullToAbsent
          ? const Value.absent()
          : Value(billToAddress),
      billToPhone: billToPhone == null && nullToAbsent
          ? const Value.absent()
          : Value(billToPhone),
      status: Value(status),
      template: Value(template),
      invoiceLanguage: Value(invoiceLanguage),
      currencyCode: Value(currencyCode),
      exchangeRateToPkr: Value(exchangeRateToPkr),
      sentAt: sentAt == null && nullToAbsent
          ? const Value.absent()
          : Value(sentAt),
      issueDate: Value(issueDate),
      dueDate: dueDate == null && nullToAbsent
          ? const Value.absent()
          : Value(dueDate),
      expiryDate: expiryDate == null && nullToAbsent
          ? const Value.absent()
          : Value(expiryDate),
      subtotal: Value(subtotal),
      discountAmount: Value(discountAmount),
      taxAmount: Value(taxAmount),
      total: Value(total),
      notes: notes == null && nullToAbsent
          ? const Value.absent()
          : Value(notes),
      terms: terms == null && nullToAbsent
          ? const Value.absent()
          : Value(terms),
      createdAt: Value(createdAt),
    );
  }

  factory Invoice.fromJson(
    Map<String, dynamic> json, {
    ValueSerializer? serializer,
  }) {
    serializer ??= driftRuntimeOptions.defaultSerializer;
    return Invoice(
      id: serializer.fromJson<int>(json['id']),
      invoiceNumber: serializer.fromJson<String>(json['invoiceNumber']),
      customerId: serializer.fromJson<int?>(json['customerId']),
      linkedSaleId: serializer.fromJson<int?>(json['linkedSaleId']),
      docType: serializer.fromJson<String>(json['docType']),
      billToName: serializer.fromJson<String?>(json['billToName']),
      billToAddress: serializer.fromJson<String?>(json['billToAddress']),
      billToPhone: serializer.fromJson<String?>(json['billToPhone']),
      status: serializer.fromJson<String>(json['status']),
      template: serializer.fromJson<String>(json['template']),
      invoiceLanguage: serializer.fromJson<String>(json['invoiceLanguage']),
      currencyCode: serializer.fromJson<String>(json['currencyCode']),
      exchangeRateToPkr: serializer.fromJson<double>(json['exchangeRateToPkr']),
      sentAt: serializer.fromJson<DateTime?>(json['sentAt']),
      issueDate: serializer.fromJson<DateTime>(json['issueDate']),
      dueDate: serializer.fromJson<DateTime?>(json['dueDate']),
      expiryDate: serializer.fromJson<DateTime?>(json['expiryDate']),
      subtotal: serializer.fromJson<double>(json['subtotal']),
      discountAmount: serializer.fromJson<double>(json['discountAmount']),
      taxAmount: serializer.fromJson<double>(json['taxAmount']),
      total: serializer.fromJson<double>(json['total']),
      notes: serializer.fromJson<String?>(json['notes']),
      terms: serializer.fromJson<String?>(json['terms']),
      createdAt: serializer.fromJson<DateTime>(json['createdAt']),
    );
  }
  @override
  Map<String, dynamic> toJson({ValueSerializer? serializer}) {
    serializer ??= driftRuntimeOptions.defaultSerializer;
    return <String, dynamic>{
      'id': serializer.toJson<int>(id),
      'invoiceNumber': serializer.toJson<String>(invoiceNumber),
      'customerId': serializer.toJson<int?>(customerId),
      'linkedSaleId': serializer.toJson<int?>(linkedSaleId),
      'docType': serializer.toJson<String>(docType),
      'billToName': serializer.toJson<String?>(billToName),
      'billToAddress': serializer.toJson<String?>(billToAddress),
      'billToPhone': serializer.toJson<String?>(billToPhone),
      'status': serializer.toJson<String>(status),
      'template': serializer.toJson<String>(template),
      'invoiceLanguage': serializer.toJson<String>(invoiceLanguage),
      'currencyCode': serializer.toJson<String>(currencyCode),
      'exchangeRateToPkr': serializer.toJson<double>(exchangeRateToPkr),
      'sentAt': serializer.toJson<DateTime?>(sentAt),
      'issueDate': serializer.toJson<DateTime>(issueDate),
      'dueDate': serializer.toJson<DateTime?>(dueDate),
      'expiryDate': serializer.toJson<DateTime?>(expiryDate),
      'subtotal': serializer.toJson<double>(subtotal),
      'discountAmount': serializer.toJson<double>(discountAmount),
      'taxAmount': serializer.toJson<double>(taxAmount),
      'total': serializer.toJson<double>(total),
      'notes': serializer.toJson<String?>(notes),
      'terms': serializer.toJson<String?>(terms),
      'createdAt': serializer.toJson<DateTime>(createdAt),
    };
  }

  Invoice copyWith({
    int? id,
    String? invoiceNumber,
    Value<int?> customerId = const Value.absent(),
    Value<int?> linkedSaleId = const Value.absent(),
    String? docType,
    Value<String?> billToName = const Value.absent(),
    Value<String?> billToAddress = const Value.absent(),
    Value<String?> billToPhone = const Value.absent(),
    String? status,
    String? template,
    String? invoiceLanguage,
    String? currencyCode,
    double? exchangeRateToPkr,
    Value<DateTime?> sentAt = const Value.absent(),
    DateTime? issueDate,
    Value<DateTime?> dueDate = const Value.absent(),
    Value<DateTime?> expiryDate = const Value.absent(),
    double? subtotal,
    double? discountAmount,
    double? taxAmount,
    double? total,
    Value<String?> notes = const Value.absent(),
    Value<String?> terms = const Value.absent(),
    DateTime? createdAt,
  }) => Invoice(
    id: id ?? this.id,
    invoiceNumber: invoiceNumber ?? this.invoiceNumber,
    customerId: customerId.present ? customerId.value : this.customerId,
    linkedSaleId: linkedSaleId.present ? linkedSaleId.value : this.linkedSaleId,
    docType: docType ?? this.docType,
    billToName: billToName.present ? billToName.value : this.billToName,
    billToAddress: billToAddress.present
        ? billToAddress.value
        : this.billToAddress,
    billToPhone: billToPhone.present ? billToPhone.value : this.billToPhone,
    status: status ?? this.status,
    template: template ?? this.template,
    invoiceLanguage: invoiceLanguage ?? this.invoiceLanguage,
    currencyCode: currencyCode ?? this.currencyCode,
    exchangeRateToPkr: exchangeRateToPkr ?? this.exchangeRateToPkr,
    sentAt: sentAt.present ? sentAt.value : this.sentAt,
    issueDate: issueDate ?? this.issueDate,
    dueDate: dueDate.present ? dueDate.value : this.dueDate,
    expiryDate: expiryDate.present ? expiryDate.value : this.expiryDate,
    subtotal: subtotal ?? this.subtotal,
    discountAmount: discountAmount ?? this.discountAmount,
    taxAmount: taxAmount ?? this.taxAmount,
    total: total ?? this.total,
    notes: notes.present ? notes.value : this.notes,
    terms: terms.present ? terms.value : this.terms,
    createdAt: createdAt ?? this.createdAt,
  );
  Invoice copyWithCompanion(InvoicesCompanion data) {
    return Invoice(
      id: data.id.present ? data.id.value : this.id,
      invoiceNumber: data.invoiceNumber.present
          ? data.invoiceNumber.value
          : this.invoiceNumber,
      customerId: data.customerId.present
          ? data.customerId.value
          : this.customerId,
      linkedSaleId: data.linkedSaleId.present
          ? data.linkedSaleId.value
          : this.linkedSaleId,
      docType: data.docType.present ? data.docType.value : this.docType,
      billToName: data.billToName.present
          ? data.billToName.value
          : this.billToName,
      billToAddress: data.billToAddress.present
          ? data.billToAddress.value
          : this.billToAddress,
      billToPhone: data.billToPhone.present
          ? data.billToPhone.value
          : this.billToPhone,
      status: data.status.present ? data.status.value : this.status,
      template: data.template.present ? data.template.value : this.template,
      invoiceLanguage: data.invoiceLanguage.present
          ? data.invoiceLanguage.value
          : this.invoiceLanguage,
      currencyCode: data.currencyCode.present
          ? data.currencyCode.value
          : this.currencyCode,
      exchangeRateToPkr: data.exchangeRateToPkr.present
          ? data.exchangeRateToPkr.value
          : this.exchangeRateToPkr,
      sentAt: data.sentAt.present ? data.sentAt.value : this.sentAt,
      issueDate: data.issueDate.present ? data.issueDate.value : this.issueDate,
      dueDate: data.dueDate.present ? data.dueDate.value : this.dueDate,
      expiryDate: data.expiryDate.present
          ? data.expiryDate.value
          : this.expiryDate,
      subtotal: data.subtotal.present ? data.subtotal.value : this.subtotal,
      discountAmount: data.discountAmount.present
          ? data.discountAmount.value
          : this.discountAmount,
      taxAmount: data.taxAmount.present ? data.taxAmount.value : this.taxAmount,
      total: data.total.present ? data.total.value : this.total,
      notes: data.notes.present ? data.notes.value : this.notes,
      terms: data.terms.present ? data.terms.value : this.terms,
      createdAt: data.createdAt.present ? data.createdAt.value : this.createdAt,
    );
  }

  @override
  String toString() {
    return (StringBuffer('Invoice(')
          ..write('id: $id, ')
          ..write('invoiceNumber: $invoiceNumber, ')
          ..write('customerId: $customerId, ')
          ..write('linkedSaleId: $linkedSaleId, ')
          ..write('docType: $docType, ')
          ..write('billToName: $billToName, ')
          ..write('billToAddress: $billToAddress, ')
          ..write('billToPhone: $billToPhone, ')
          ..write('status: $status, ')
          ..write('template: $template, ')
          ..write('invoiceLanguage: $invoiceLanguage, ')
          ..write('currencyCode: $currencyCode, ')
          ..write('exchangeRateToPkr: $exchangeRateToPkr, ')
          ..write('sentAt: $sentAt, ')
          ..write('issueDate: $issueDate, ')
          ..write('dueDate: $dueDate, ')
          ..write('expiryDate: $expiryDate, ')
          ..write('subtotal: $subtotal, ')
          ..write('discountAmount: $discountAmount, ')
          ..write('taxAmount: $taxAmount, ')
          ..write('total: $total, ')
          ..write('notes: $notes, ')
          ..write('terms: $terms, ')
          ..write('createdAt: $createdAt')
          ..write(')'))
        .toString();
  }

  @override
  int get hashCode => Object.hashAll([
    id,
    invoiceNumber,
    customerId,
    linkedSaleId,
    docType,
    billToName,
    billToAddress,
    billToPhone,
    status,
    template,
    invoiceLanguage,
    currencyCode,
    exchangeRateToPkr,
    sentAt,
    issueDate,
    dueDate,
    expiryDate,
    subtotal,
    discountAmount,
    taxAmount,
    total,
    notes,
    terms,
    createdAt,
  ]);
  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      (other is Invoice &&
          other.id == this.id &&
          other.invoiceNumber == this.invoiceNumber &&
          other.customerId == this.customerId &&
          other.linkedSaleId == this.linkedSaleId &&
          other.docType == this.docType &&
          other.billToName == this.billToName &&
          other.billToAddress == this.billToAddress &&
          other.billToPhone == this.billToPhone &&
          other.status == this.status &&
          other.template == this.template &&
          other.invoiceLanguage == this.invoiceLanguage &&
          other.currencyCode == this.currencyCode &&
          other.exchangeRateToPkr == this.exchangeRateToPkr &&
          other.sentAt == this.sentAt &&
          other.issueDate == this.issueDate &&
          other.dueDate == this.dueDate &&
          other.expiryDate == this.expiryDate &&
          other.subtotal == this.subtotal &&
          other.discountAmount == this.discountAmount &&
          other.taxAmount == this.taxAmount &&
          other.total == this.total &&
          other.notes == this.notes &&
          other.terms == this.terms &&
          other.createdAt == this.createdAt);
}

